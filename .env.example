# Django設定
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-new-one
ALLOWED_HOSTS=oc-stamp.cc.it-hiroshima.ac.jp,150.19.10.214,localhost,127.0.0.1,app
# HTTPSを有効にしたらTrue（HTTP運用中はFalse）
ENABLE_HTTPS=True

# Let's Encrypt の証明書ディレクトリ名（/etc/letsencrypt/live/<domain>/...）
LETSENCRYPT_DOMAIN=oc-stamp.cc.it-hiroshima.ac.jp

# データベース設定（PostgreSQL本番用）
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=strongpassword123
# 通常は db。名前解決に問題がある場合は django-db-prod に変更して確認
DB_HOST=db
DB_PORT=5432
# PostgreSQL接続失敗を早く検出（秒）
DB_CONNECT_TIMEOUT=5
# 起動時にDBポート待機する最大秒数
DB_WAIT_SECONDS=180
# DB待機の再試行間隔（秒）
DB_WAIT_INTERVAL=3
