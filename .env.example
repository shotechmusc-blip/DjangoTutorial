# 公開情報
PUBLIC_DOMAIN=oc-stamp.cc.it-hiroshima.ac.jp
PUBLIC_IP=150.19.10.214

# Django
DEBUG=False
ENABLE_HTTPS=True
SECRET_KEY=replace-with-generated-secret-key
ALLOWED_HOSTS=oc-stamp.cc.it-hiroshima.ac.jp,150.19.10.214,localhost,127.0.0.1,app

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=stampdb_prod
DB_USER=stampadmin
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_WAIT_SECONDS=180
DB_WAIT_INTERVAL=3

# Gunicorn
GUNICORN_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Docker build settings
# Docker内部DNSに問題があるサーバーでは host に変更
DOCKER_BUILD_NETWORK=host
PIP_INDEX_URL=https://pypi.org/simple

# Docker bridge name for stable UFW route rules
APP_BRIDGE_NAME=stampbr0

# Let's Encrypt 証明書配置先（ホスト側）
LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live/oc-stamp.cc.it-hiroshima.ac.jp
